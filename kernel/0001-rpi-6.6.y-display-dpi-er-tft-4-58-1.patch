index 000000000000..8e09ccb96a32
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/vc4-kms-dpi-er-tft-4-58-1-overlay.dts
@@ -0,0 +1,160 @@
+/*
+ * vc4-kms-dpi-er_tft_4_58_1.dts
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/bcm2835.h>
+
+/ {
+	compatible = "brcm,bcm2835";
+
+	fragment@0 {
+		target-path = "/";
+		__overlay__ {
+			pwm_gpio: pwm_gpio@27 {
+				#pwm-cells = <2>;
+				compatible = "pwm-gpio";
+				pinctrl-names = "default";
+				pinctrl-0 = <&pwm_gpio_pins>;
+				gpios = <&gpio 27 0>;
+				status = "okay";
+				enabled = <1>;
+			};
+		};
+	};
+
+	fragment@1 {
+		target-path = "/";
+		__overlay__ {
+
+			backlight: backlight {
+				compatible = "pwm-backlight";
+				pwms = <&pwm_gpio 0 5000000 0>;
+		
+				brightness-levels = <0 4 8 16 32 64 128 255>;
+				default-brightness-level = <3>;
+		
+				// post-pwm-on-delay-ms = <10>;
+				// pwm-off-delay-ms = <10>;
+			};
+
+			spi {
+				compatible = "spi-gpio";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				pinctrl-0 = <&spi_pins>;
+				pinctrl-names = "default";
+
+				sck-gpios = <&gpio 25 GPIO_ACTIVE_HIGH>;
+				mosi-gpios = <&gpio 24 GPIO_ACTIVE_HIGH>;
+				cs-gpios = <&gpio 26 GPIO_ACTIVE_LOW>;
+				num-chipselects = <1>;
+				sck-idle-input;
+
+				panel: display@0 {
+					reg = <0>;
+					/* 100 kHz */
+					spi-max-frequency = <100000>;
+					backlight = <&backlight>;
+					rotation = <90>;
+
+					compatible = "muroda,er-tft-4.58-1";
+
+					port {
+						panel_in: endpoint {
+							remote-endpoint = <&dpi_out>;
+						};
+					};
+				};
+			};
+		};
+	};
+
+	fragment@2 {
+		target = <&dpi>;
+		__overlay__  {
+			status = "okay";
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&dpi_16bit_gpio0>;
+
+			port {
+				dpi_out: endpoint {
+					remote-endpoint = <&panel_in>;
+				};
+			};
+		};
+	};
+
+	fragment@3 {
+		target = <&gpio>;
+		__overlay__ {
+			spi_pins: er_tft_4_58_1_spi_pins {
+				brcm,pins = <25 26 24>;
+				brcm,pull = <BCM2835_PUD_UP BCM2835_PUD_UP BCM2835_PUD_OFF>;
+				brcm,function = <0>;
+			};
+		};
+	};
+
+	fragment@4 {
+		target-path = "/";
+		__overlay__ {
+			i2c_gpio: i2c@0 {
+				compatible = "i2c-gpio";
+				gpios = <&gpio 22 0 /* sda */
+					 &gpio 23 0>; /* scl */
+				i2c-gpio,delay-us = <4>;        /* ~100 kHz */
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+	};
+
+	fragment@5 {
+		target = <&gpio>;
+		__overlay__ {
+			pwm_gpio_pins: pwm_gpio_pins@27 {
+				brcm,pins = <27>; /* gpio 4 */
+				brcm,function = <1>; /* output */
+				brcm,pull = <0>; /* pull-none */
+			};
+		};
+	};
+
+
+	fragment@6 {
+		target = <&i2c_gpio>;
+		__overlay__ {
+			/* needed to avoid dtc warning */
+			#address-cells = <1>;
+			#size-cells = <0>;
+			ft6236_5d: ft6236@5d {
+				compatible = "goodix,gt911";
+				reg = <0x5d>;
+				interrupt-parent = <&gpio>;
+				interrupts = <21 2>;
+				touchscreen-size-x = <320>;
+				touchscreen-size-y = <960>;
+				touchscreen-x-mm = <37>;
+				touchscreen-y-mm = <110>;
+				// touchscreen-inverted-y;
+				// touchscreen-swapped-x-y;
+			};
+		};
+	};
+
+	
+	__overrides__ {
+		gpio = <&pwm_gpio>,"gpios:27",
+		       <&pwm_gpio_pins>,"brcm,pins:0",
+		       /* modify reg values to allow multiple instantiation */
+		       <&pwm_gpio>,"reg:0",
+		       <&pwm_gpio_pins>,"reg:0";
+
+		rotate = <&panel>, "rotation:90";
+	};
+};
