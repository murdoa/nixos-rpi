+	ST7701_SPI(st7701, 0xe2, 0x133, 0x133, 0x133, 0x133, 0x1c9, 0x13c, 0x100, 0x100, 0x1ca, 0x13c, 0x100, 0x100, 0x100);
+	ST7701_SPI(st7701, 0xe3, 0x100, 0x100, 0x133, 0x133);
