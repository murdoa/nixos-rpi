+	ST7701_SPI(st7701, 0xe6, 0x100, 0x100, 0x133, 0x133);
+	ST7701_SPI(st7701, 0xe7, 0x144, 0x144);
+	ST7701_SPI(st7701, 0xe8, 0x106, 0x1ce, 0x182, 0x182, 0x102, 0x1ca, 0x182, 0x182, 0x108, 0x1d0, 0x182, 0x182, 0x104, 0x1cc, 0x182, 0x182);
+	ST7701_SPI(st7701, 0xeb, 0x108, 0x101, 0x1e4, 0x1e4, 0x188, 0x100, 0x140);
+	ST7701_SPI(st7701, 0xec, 0x100, 0x100, 0x100);
+	ST7701_SPI(st7701, 0xed, 0x1ff, 0x1f0, 0x107, 0x165, 0x14f, 0x1fc, 0x1c2, 0x12f, 0x1f2, 0x12c, 0x1cf, 0x1f4, 0x156, 0x170, 0x10f, 0x1ff);
